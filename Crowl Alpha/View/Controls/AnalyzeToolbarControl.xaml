<UserControl x:Class="Crowl_Alpha.View.Controls.AnalyzeToolbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Crowl_Alpha.View.Controls"
             xmlns:vm="clr-namespace:Crowl_Alpha.ViewModel"
             xmlns:converters="clr-namespace:Crowl_Alpha.ViewModel.ValueConverters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <!-- #region Control Resources -->
    <UserControl.Resources>
        <vm:MainVM x:Key="vm" />
        <converters:BoolToColorMultiConverter x:Key="BoolToColorMultiConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:ReloadIconConverter x:Key="ReloadIconConverter" />
        <converters:ToolSelectionConverter x:Key="ToolSelectionConverter" />
        <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
    </UserControl.Resources>
    <!--#endregion-->

    <!--#region Analyze Toolbar -->
    <Border BorderBrush="#33FFFFFF"
            BorderThickness="0 0 0 1"
            Grid.Row="0"
            Visibility="{Binding AnalyzedUrl, Converter={StaticResource IsNotNullOrEmptyConverter}}">
        <Grid Height="70">

            <!--#region Analyze Toolbar Grid Def -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--#endregion-->

            <!--#region Stop Analysis Button -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="20"
                        Grid.Column="0">

                <Button Style="{DynamicResource MaterialDesignFlatButton}"
                        Command="{Binding StopAnalyzeCommand}"
                        Cursor="Hand"
                        Padding="0 0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="StepBackward"
                                                 Width="35"
                                                 Height="35"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="Navigate"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Margin="5 0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <!--#endregion-->

            <!--#region Analysis Tools -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="10 0"
                        Grid.Column="1">

                <!--#region ClickListener Tool-->
                <ToggleButton IsChecked="{Binding SelectedTool, ConverterParameter=ClickListener, Converter={StaticResource ToolSelectionConverter}}"
                              Style="{DynamicResource MaterialDesignFlatPrimaryToggleButton}"
                              Foreground="White"
                              Cursor="Hand"
                              Margin="10 0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Crosshairs" />
                    </StackPanel>
                </ToggleButton>
                <!--#endregion-->

                <!--#region Selection Tool -->
                <ToggleButton IsChecked="{Binding SelectedTool, ConverterParameter=Tool2, Converter={StaticResource ToolSelectionConverter}}"
                              Style="{DynamicResource MaterialDesignFlatPrimaryToggleButton}"
                              Foreground="White"
                              Cursor="Hand"
                              Margin="10 0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Selection" />
                    </StackPanel>
                </ToggleButton>
                <!--#endregion-->

                <!--#region Info Tool -->
                <ToggleButton IsChecked="{Binding SelectedTool, ConverterParameter=Tool3, Converter={StaticResource ToolSelectionConverter}}"
                              Style="{DynamicResource MaterialDesignFlatPrimaryToggleButton}"
                              Foreground="White"
                              Cursor="Hand"
                              Margin="10 0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Information" />
                    </StackPanel>
                </ToggleButton>
                <!--#endregion-->

            </StackPanel>
            <!--#endregion-->

        </Grid>
    </Border>
    <!--#endregion-->
</UserControl>
