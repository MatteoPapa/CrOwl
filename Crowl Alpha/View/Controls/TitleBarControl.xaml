<UserControl x:Class="Crowl_Alpha.View.Controls.TitleBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Crowl_Alpha.View.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Crowl_Alpha.ViewModel.ValueConverters"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <converters:WindowStateToIconConverter x:Key="WindowStateToIconConverter" />
    </UserControl.Resources>
    
    <Border BorderBrush="#11FFFFFF"
            BorderThickness="0,0,0,2">
        <Grid Height="60"
              Margin="10 5 0 0"
              VerticalAlignment="Top"
              Background="Transparent"
              MouseDown="TitleBar_MouseDown">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Window Title -->
            <StackPanel Orientation="Horizontal"
                        Margin="5 5">
                <Image Source="../Images/crowlLogoWhite.png"
                       Margin="3"
                       VerticalAlignment="Bottom" />
                <TextBlock Text="CrOwl"
                           VerticalAlignment="Center"
                           Margin="10"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="19" />
            </StackPanel>

            <!-- Minimize, Maximize, Close Buttons -->
            <StackPanel Orientation="Horizontal"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <!-- Minimize Button -->
                <Button Content="{materialDesign:PackIcon Kind=WindowMinimize}"
                        Style="{DynamicResource MaterialDesignFlatButton}"
                        Margin="2 0"
                        Background="Transparent"
                        Foreground="White"
                        Click="MinimizeWindow" />
                <!-- Maximize/Restore Button -->
                <Button Style="{DynamicResource MaterialDesignFlatButton}"
                        Margin="2,0,2,0"
                        Background="Transparent"
                        Foreground="White"
                        Click="MaximizeRestoreWindow">
                    <materialDesign:PackIcon Kind="{Binding WindowState, 
                                        RelativeSource={RelativeSource AncestorType=Window}, 
                                        Converter={StaticResource WindowStateToIconConverter}}"
                                             Width="16"
                                             Height="16" />
                </Button>
                <!-- Close Button -->
                <Button Content="{materialDesign:PackIcon Kind=WindowClose}"
                        Style="{DynamicResource MaterialDesignFlatButton}"
                        Margin="2 0 5 0"
                        Foreground="White"
                        Click="CloseWindow" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
