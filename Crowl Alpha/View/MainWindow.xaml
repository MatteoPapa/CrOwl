<Window x:Class="Crowl_Alpha.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Crowl_Alpha.View"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:uc="clr-namespace:Crowl_Alpha.View.Controls"
        xmlns:vm="clr-namespace:Crowl_Alpha.ViewModel"
        xmlns:converters="clr-namespace:Crowl_Alpha.ViewModel.ValueConverters"
        xmlns:cefSharp="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
        Style="{StaticResource MaterialDesignWindow}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        mc:Ignorable="d"
        Title="CrOwl"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Closing="Window_Closing"
        Height="972"
        Width="1728">

    <!-- #region Window Resources -->
    <Window.Resources>
        <vm:MainVM x:Key="vm" />
        <converters:BoolToColorMultiConverter x:Key="BoolToColorMultiConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:ReloadIconConverter x:Key="ReloadIconConverter" />
    </Window.Resources>
    <!--#endregion-->

    <!--#region Window Chrome-->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="5"
                      CornerRadius="10"
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <!--#endregion-->

    <Border BorderBrush="#44FFFFFF"
            BorderThickness="1"
            CornerRadius="10"
            Background="{DynamicResource MaterialDesign.Brush.Background}">
        <DockPanel>

            <!--#region Custom Title Bar -->
            <uc:TitleBarControl DockPanel.Dock="Top" />
            <!--#endregion-->


            <!-- Main Content Area -->
            <Grid DataContext="{Binding Source={StaticResource vm}}">

                <!--#region Main Grid Definition -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <!--#endregion-->

                <!--#region Browser Section -->

                <Grid Grid.Column="0">

                    <!-- #region Browser Grid Definition -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--#endregion-->

                    <!--#region Toolbar -->
                    <Border BorderBrush="#33FFFFFF"
                            BorderThickness="0 0 0 1"
                            Grid.Row="0">
                        <Grid Height="70">

                            <!--#region Toolbar Grid Def -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.3*" />
                                <ColumnDefinition Width="0.3*" />
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!--#endregion-->

                            <!--#region Back/Forward Buttons -->
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Content="{materialDesign:PackIcon Kind=ArrowLeftBold, Size=30}"
                                        Command="{Binding BrowserGoBackCommand, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding CanGoBack}"
                                        Foreground="White"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Padding="0"
                                        Style="{DynamicResource MaterialDesignFlatButton}" />
                                <Button Content="{materialDesign:PackIcon Kind=ArrowRightBold, Size=30}"
                                        Command="{Binding BrowserGoForwardCommand, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding CanGoForward}"
                                        Margin="10 0 0 0"
                                        Foreground="White"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Padding="0"
                                        Style="{DynamicResource MaterialDesignFlatButton}" />
                            </StackPanel>
                            <!--#endregion-->
                            
                            <!--#region Reload Button -->
                            <Button Grid.Column="1"
                                    Command="{Binding GoToUrlCommand, UpdateSourceTrigger=PropertyChanged}"
                                    CommandParameter="{Binding SearchIsReadyVariable}"
                                    Style="{DynamicResource MaterialDesignFlatDarkBgButton}"
                                    Width="50"
                                    HorizontalAlignment="Center"
                                    HorizontalContentAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="10">
                                <Button.Content>
                                    <MultiBinding Converter="{StaticResource ReloadIconConverter}">
                                        <Binding Path="Url" />
                                        <Binding Path="SearchedUrl" />
                                    </MultiBinding>
                                </Button.Content>
                            </Button>
                            <!--#endregion-->
                            
                            <!--#region Url TextBox -->
                            <Grid Grid.Column="2"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Stretch"
                                  Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <materialDesign:PackIcon Kind="Web"
                                                         Width="30"
                                                         Height="30"
                                                         Foreground="White"
                                                         VerticalAlignment="Center"
                                                         Margin="5" />

                                <!-- TextBox -->
                                <TextBox Grid.Column="1"
                                         Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Stretch"
                                         Foreground="White"
                                         FontSize="16"
                                         Padding="5,0">

                                    <!-- InputBindings for Enter Key -->
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter"
                                                    Command="{Binding GoToUrlCommand}"
                                                    CommandParameter="{Binding SearchIsReadyVariable}" />
                                    </TextBox.InputBindings>

                                </TextBox>
                            </Grid>
                            <!--#endregion-->



                            <!--#region Incognito ToggleSwitch -->
                            <StackPanel Grid.Column="3"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="30 0">
                                <ToggleButton Margin="15 0"
                                              IsChecked="{Binding TorEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Command="{Binding TorSwitchCommand}" />

                                <materialDesign:PackIcon Kind="Incognito"
                                                         Visibility="{Binding SearchIsReadyVariable, Converter={StaticResource BoolToVisibilityConverter}}"
                                                         VerticalAlignment="Center"
                                                         Width="40"
                                                         Height="40">
                                    <materialDesign:PackIcon.Foreground>
                                        <MultiBinding Converter="{StaticResource BoolToColorMultiConverter}">
                                            <Binding Path="SearchIsReadyVariable" />
                                            <Binding Path="TorEnabled" />
                                            <!-- Add more bindings as needed -->
                                        </MultiBinding>
                                    </materialDesign:PackIcon.Foreground>
                                </materialDesign:PackIcon>

                                <ProgressBar IsIndeterminate="True"
                                             Width="40"
                                             Height="40"
                                             Visibility="{Binding SearchIsReadyVariable, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                             Style="{DynamicResource MaterialDesignCircularProgressBar}" />

                            </StackPanel>
                            <!--#endregion-->

                        </Grid>
                    </Border>
                    <!--#endregion-->

                    <!--#region Chromium Web Browser -->
                    <Grid Grid.Row="1"
                          x:Name="BrowserGrid"
                          Background="White">
                        <cefSharp:ChromiumWebBrowser x:Name="browser"
                                                     Address="{Binding SearchedUrl}" />
                    </Grid>


                    <!--#endregion-->

                </Grid>

                <!--#endregion-->

                <!--#region GridSplitter-->
                <GridSplitter Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Width="5"
                              Background="#22FFFFFF"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="True" />
                <!--#endregion-->

                <Grid Grid.Column="2">
                </Grid>

            </Grid>
        </DockPanel>
    </Border>

</Window>
