<Window x:Class="Crowl_Alpha.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Crowl_Alpha.View"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:uc="clr-namespace:Crowl_Alpha.View.Controls"
        xmlns:vm="clr-namespace:Crowl_Alpha.ViewModel"
        xmlns:converters="clr-namespace:Crowl_Alpha.ViewModel.ValueConverters"
        xmlns:cefSharp="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
        xmlns:model="clr-namespace:Crowl_Alpha.Model"
        xmlns:behaviors="clr-namespace:Crowl_Alpha.View.Behaviors"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Style="{StaticResource MaterialDesignWindow}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        mc:Ignorable="d"
        Title="CrOwl"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Closing="Window_Closing"
        Height="972"
        Width="1728">

    <!-- #region Window Resources -->
    <Window.Resources>
        <vm:MainVM x:Key="vm" />
        <converters:BoolToColorMultiConverter x:Key="BoolToColorMultiConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:ReloadIconConverter x:Key="ReloadIconConverter" />
        <converters:ToolSelectionConverter x:Key="ToolSelectionConverter" />
        <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
    </Window.Resources>
    <!--#endregion-->

    <!--#region Window Chrome-->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="5"
                      CornerRadius="10"
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <!--#endregion-->

    <Border BorderBrush="#44FFFFFF"
            BorderThickness="1"
            CornerRadius="10"
            Background="{DynamicResource MaterialDesign.Brush.Background}">
        <DockPanel>

            <uc:TitleBarControl DockPanel.Dock="Top" />

            <!-- Main Content Area -->
            <Grid DataContext="{Binding Source={StaticResource vm}}">

                <!--#region Main Grid Definition -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <!--#endregion-->

                <!--#region Browser Section -->

                <Grid Grid.Column="0">

                    <!-- #region Browser Grid Definition -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--#endregion-->

                    <uc:NavigationToolbarControl DataContext="{Binding}" />

                    <uc:AnalyzeToolbarControl DataContext="{Binding}" />

                    <!--#region Chromium Web Browser -->
                    <Grid Grid.Row="1"
                          x:Name="BrowserGrid"
                          Background="White">
                        <cefSharp:ChromiumWebBrowser x:Name="browser"
                                                     Address="{Binding SearchedUrl}" />
                    </Grid>

                    <!--#endregion-->

                </Grid>

                <!--#endregion-->

                <!--#region GridSplitter-->
                <GridSplitter Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Width="5"
                              Background="#22FFFFFF"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="True" />
                <!--#endregion-->

                <!--#region Analyze Section -->
                <Grid Grid.Column="2">

                    <!--#region Analyze Grid Definition-->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="2" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--#endregion-->

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- #region Analyze Button -->
                        <StackPanel Margin="10"
                                    Grid.Row="0">
                            <Button Content="Analyze"
                                    Width="200"
                                    Command="{Binding AnalyzeCommand}"
                                    Visibility="{Binding AnalyzedUrl,Converter={StaticResource IsNotNullOrEmptyConverter}, ConverterParameter=Invert}" />
                        </StackPanel>
                        <!--#endregion-->

                        <!-- #region TabControl  -->
                        <TabControl Grid.Row="0"
                                    Visibility="{Binding AnalyzedUrl,Converter={StaticResource IsNotNullOrEmptyConverter}}">

                            <TabItem Header="Treeview">
                                <uc:AnalysisTreeViewControl DataContext="{Binding}" />
                            </TabItem>
                            
                            <TabItem Header="Selected Item">
                                <uc:SelectedItemDetailsControl DataContext="{Binding}" />
                            </TabItem>


                            <!-- Eventual additional TabItems as needed -->
                            <!-- ... -->

                        </TabControl>
                        <!--#endregion-->

                    </Grid>

                    <!--#region GridSplitter-->
                    <GridSplitter Grid.Row="1"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Height="2"
                                  Background="#22FFFFFF"
                                  ResizeBehavior="PreviousAndNext"
                                  ShowsPreview="True" />
                    <!--#endregion-->

                </Grid>
                <!--#endregion-->

            </Grid>
        </DockPanel>
    </Border>

</Window>
